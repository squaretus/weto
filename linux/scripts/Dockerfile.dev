# Окружение разработки Linux-версии weto.
#
# База — Debian trixie: там GTK4 новее пола, объявленного проектом (4.14 из
# Ubuntu 24.04 LTS). Собирать на образе с GTK старше пола нельзя: бинарник
# слинкуется с символами, которых на целевых системах может не быть.
FROM rust:1-trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgtk-4-dev \
        libssl-dev \
        pkg-config \
        zstd \
        iproute2 \
        # GTK не поднимается без дисплея, а тесты обязаны идти без монитора.
        xvfb \
        xauth \
        # Трей и уведомления живут на шине; для тестов нужна сессионная.
        dbus-x11 \
        # Терминальная версия собирается статически под musl (build.sh):
        # musl-gcc собирает C-части ring и zstd.
        musl-tools \
        # Общие крейты собираются и под Windows: `cargo check` для
        # x86_64-pc-windows-gnu ловит Linux-зависимость, протёкшую в общий
        # код, до прогона на раннере Windows. mingw собирает C-части ring.
        gcc-mingw-w64-x86-64 \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add clippy rustfmt \
    && rustup target add "$(uname -m)-unknown-linux-musl" x86_64-pc-windows-gnu
