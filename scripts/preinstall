#!/bin/bash
set -u

LABEL="com.weto.app"
LEGACY_PLIST="/Library/LaunchAgents/$LABEL.plist"

CONSOLE_USER=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || echo "")

if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    USER_UID=$(id -u "$CONSOLE_USER")

    # Домашний каталог спрашиваем у системы, а не собираем из /Users/<имя>:
    # он может быть где угодно, включая сетевые и переименованные каталоги.
    HOME_DIR=$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')

    /bin/launchctl asuser "$USER_UID" /bin/launchctl bootout "gui/$USER_UID/$LABEL" 2>/dev/null || true

    if [ -n "$HOME_DIR" ]; then
        /bin/rm -f "$HOME_DIR/Library/LaunchAgents/$LABEL.plist"
    fi
fi

# Агент прежних версий лежал в системном каталоге и приложением не управлялся.
/bin/rm -f "$LEGACY_PLIST"

# Демон обновления держит собственный бинарник; его надо выгрузить до подмены файла,
# иначе launchd продолжит держать старую копию. Именно этот шаг убивает демон,
# когда установку запускает он сам.
/bin/launchctl bootout system/com.weto.helper 2>/dev/null || true

/usr/bin/killall WetoMenuBar 2>/dev/null || true

exit 0
