#!/bin/bash
# Остановить работающий экземпляр перед заменой бандла.
# При обновлении из-под installer'а $USER = root, поэтому GUI-пользователя
# определяем по владельцу /dev/console.

CONSOLE_USER=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || echo "")
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    CURRENT_UID=$(id -u "$CONSOLE_USER")
else
    CURRENT_UID=$(id -u "$USER")
fi

launchctl bootout gui/"$CURRENT_UID"/com.weto.app 2>/dev/null || true
killall WetoMenuBar 2>/dev/null || true

# Пользовательский агент из ручной установки: PKG ставит системный,
# два одновременно приводили бы к двум процессам и гонке за singleton-порт.
rm -f "/Users/$CONSOLE_USER/Library/LaunchAgents/com.weto.app.plist" 2>/dev/null || true

exit 0
