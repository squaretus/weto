<!--
    Сгенерировано shared/tools/gen-tokens из shared/tokens/design-tokens.json.
    Руками не править: CI перегенерирует и сверяет.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WetoAmberColor">#FFF2B544</Color>
    <SolidColorBrush x:Key="WetoAmber" Color="{StaticResource WetoAmberColor}"/>
    <Color x:Key="WetoCardColor">#FF201F28</Color>
    <SolidColorBrush x:Key="WetoCard" Color="{StaticResource WetoCardColor}"/>
    <Color x:Key="WetoCloseColor">#FFFF5F56</Color>
    <SolidColorBrush x:Key="WetoClose" Color="{StaticResource WetoCloseColor}"/>
    <Color x:Key="WetoDimColor">#A8F4F2FB</Color>
    <SolidColorBrush x:Key="WetoDim" Color="{StaticResource WetoDimColor}"/>
    <Color x:Key="WetoFaintColor">#66F4F2FB</Color>
    <SolidColorBrush x:Key="WetoFaint" Color="{StaticResource WetoFaintColor}"/>
    <Color x:Key="WetoGreenColor">#FF46D09B</Color>
    <SolidColorBrush x:Key="WetoGreen" Color="{StaticResource WetoGreenColor}"/>
    <Color x:Key="WetoInkColor">#FFF4F2FB</Color>
    <SolidColorBrush x:Key="WetoInk" Color="{StaticResource WetoInkColor}"/>
    <Color x:Key="WetoLineColor">#14FFFFFF</Color>
    <SolidColorBrush x:Key="WetoLine" Color="{StaticResource WetoLineColor}"/>
    <Color x:Key="WetoRedColor">#FFFF6B81</Color>
    <SolidColorBrush x:Key="WetoRed" Color="{StaticResource WetoRedColor}"/>
    <Color x:Key="WetoShellColor">#FF17161D</Color>
    <SolidColorBrush x:Key="WetoShell" Color="{StaticResource WetoShellColor}"/>
    <Color x:Key="WetoSunkColor">#FF2A2833</Color>
    <SolidColorBrush x:Key="WetoSunk" Color="{StaticResource WetoSunkColor}"/>
    <Color x:Key="WetoSunkLineColor">#00000000</Color>
    <SolidColorBrush x:Key="WetoSunkLine" Color="{StaticResource WetoSunkLineColor}"/>
    <Color x:Key="WetoVioletColor">#FF8B7BFF</Color>
    <SolidColorBrush x:Key="WetoViolet" Color="{StaticResource WetoVioletColor}"/>
    <Color x:Key="WetoPanelShadowColor">#52140A32</Color>
    <Color x:Key="WetoCardShadowColor">#00000000</Color>

    <x:Double x:Key="WetoSpace1">3</x:Double>
    <x:Double x:Key="WetoSpace2">6</x:Double>
    <x:Double x:Key="WetoSpace3">9</x:Double>
    <x:Double x:Key="WetoSpace4">12</x:Double>
    <x:Double x:Key="WetoSpace5">18</x:Double>
    <x:Double x:Key="WetoBadgeInset">2</x:Double>
    <x:Double x:Key="WetoControlHeight">32</x:Double>
    <x:Double x:Key="WetoControlHeightCompact">24</x:Double>
    <x:Double x:Key="WetoPopupWidth">480</x:Double>
    <x:Double x:Key="WetoWindowHeight">640</x:Double>
    <x:Double x:Key="WetoWindowWidth">500</x:Double>
    <CornerRadius x:Key="WetoRadiusCard">15</CornerRadius>
    <CornerRadius x:Key="WetoRadiusControl">12</CornerRadius>
    <CornerRadius x:Key="WetoRadiusPanel">20</CornerRadius>
    <CornerRadius x:Key="WetoRadiusPill">11</CornerRadius>
    <CornerRadius x:Key="WetoRadiusTile">10</CornerRadius>

    <Style x:Key="WetoTextButton" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="WetoTextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="WetoTextCardCap" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="100"/>
    </Style>
    <Style x:Key="WetoTextData" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="WetoTextDiagnostics" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="WetoTextLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="WetoTextSegment" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="WetoTextStatus" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="WetoTextValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
</ResourceDictionary>
