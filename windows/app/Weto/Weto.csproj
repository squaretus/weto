<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Приложение Weto для Windows: WinUI 3, неупакованное, self-contained
    (Windows App SDK едет внутри, установщик ставит его per-user без прав
    администратора). Всё состояние и вся логика — в weto_ffi.dll (Rust,
    windows/crates/weto-ffi); здесь только рисование и Windows-оболочка.

    Сборка: сначала Rust-мост и иконки (windows/scripts/build.ps1 делает всё),
    затем dotnet publish -r win-x64 | win-arm64 -p:Platform=x64 | ARM64.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Weto</RootNamespace>
    <AssemblyName>Weto</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Weto.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <!-- Иконки собирает weto-icons из shared/icon, мост — cargo; в репозитории их нет. -->
  <ItemGroup>
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <RustTriple Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</RustTriple>
    <RustTriple Condition="'$(RustTriple)' == ''">x86_64-pc-windows-msvc</RustTriple>
    <RustProfile Condition="'$(Configuration)' == 'Release'">release</RustProfile>
    <RustProfile Condition="'$(RustProfile)' == ''">debug</RustProfile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\crates\target\$(RustTriple)\$(RustProfile)\weto_ffi.dll"
          Link="weto_ffi.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
