<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Weto.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Тема приложения своя и выбирается явно (Тёмная / Светлая),
                     системной не следует — канон docs/design-system.md. Словарь
                     темы подменяет App.ApplyTheme; здесь — тёмная по умолчанию. -->
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
